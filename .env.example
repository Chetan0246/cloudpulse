# ──────────────────────────────────────────────────────────────────────────────
# CloudPulse Environment Variables — EXAMPLE FILE
# Copy this to .env (local only, never committed) and fill in real values.
# For Lambda, these are set via the SAM template / AWS Systems Manager.
# ──────────────────────────────────────────────────────────────────────────────

# ── AWS Region ──
AWS_REGION=ap-south-1

# ── DynamoDB Table Names ──
# Set automatically by SAM template via !Ref; define here for local dev.
DYNAMODB_RESOURCES_TABLE=cloudpulse-resources
DYNAMODB_INCIDENTS_TABLE=cloudpulse-incidents

# ── CloudWatch ──
CLOUDWATCH_NAMESPACE=CloudPulse

# ── EventBridge ──
EVENTBRIDGE_BUS_NAME=default

# ── SNS ──
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:cloudpulse-notifications

# ── Notification Email (for SNS subscription) ──
# This value is used during `sam deploy` to create the SNS email subscription.
NOTIFICATION_EMAIL=your-email@example.com

# ── Simulator Config ──
# How often (seconds) the simulator runs between metric updates (local only).
SIMULATOR_INTERVAL_SECONDS=120

# ── API Config ──
# CORS origin allowed by API Gateway / FastAPI.
# In production this is the S3 website URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Logging ──
LOG_LEVEL=INFO

# ── Frontend (Vite) ──
# These are read by the React app at build time. Must be prefixed with VITE_.
VITE_API_BASE_URL=http://localhost:3000
VITE_POLL_INTERVAL_MS=10000
